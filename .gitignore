# Obsidian local workspace/cache (keep shared config, ignore per-machine state)
# ** prefix so this also applies to nested vaults, not just the root one
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json
**/.obsidian/plugins/
**/.obsidian/community-plugins.json

# Dependencies
node_modules/
dist/

# Claude Code / Claudesidian / Smart Connections (session & cache data)
.claude/
.claudian/
.smart-env/

# Secrets — never commit API keys
.bybit/
.exchanges/
credentials.json
config.json
*.key
.env

# Trading book — autogenerated by scripts/fill_book.py, lives locally only
TRADING_BOOK.xlsx
.~lock.*#

# OS / misc
desktop.ini
*.log

# Live data logs (collector output)
TRADING-SYSTEM/scripts/portfolio/data/

# Telegram-экспорт (медиа, не для git)
ChatExport_*/

# Syncthing (версии и служебные метки — не для git)
.stversions/
.stfolder*
.trash/

# Моно-репо: r_tail03 архивируется локально (D:\Backup), не в git

# Python bytecode
__pycache__/
*.pyc

# R_tail: личная переписка (даже вычищенная) — только локально / Google Drive, не в публичный git
**/_telegram_archive/
**/.obsidian/workspace*.json

# Чужие книги/PDF — не распространяем в публичном git (лежат на D:, Google Drive и смарте)
R_tail.0.4/**/*.pdf
R_tail.0.4/**/*.fb2*
R_tail.0.4/**/*.epub
R_tail.0.4/**/*.djvu

# Мусорные логины — не возвращать
*noltic_logins*

# R_tail: исходные пакеты карточек claude.ai — уже разложены по R_comedy/, в репо не нужны (_coord 2026-11-10)
R_tail.0.4/R_tail_карточки_*.md
